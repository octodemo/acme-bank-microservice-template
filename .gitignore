# Build output
bin/
obj/
out/
TestResults/
coverage-report/
*.trx
*.coverage
*.coveragexml

# User and IDE files
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# OS files
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Azure Developer CLI
# azd state — the demo `dev` env is checked in so `azd init -t ... -e dev`
# starts with the right resource group / subscription. Any other env name
# stays local-only.
.azure/*
!.azure/dev/
.azure/dev/*.log

# Environment and secrets
.env
.env.*
*.pfx
*.key
