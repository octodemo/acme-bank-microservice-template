{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "serviceName": {
      "value": "myservice"
    },
    "imageName": {
      "value": "${SERVICE_MYSERVICE_IMAGE_NAME}"
    },
    "managedIdentityResourceId": {
      "value": "${SHARED_MANAGED_IDENTITY_ID}"
    },
    "containerAppsEnvironmentResourceId": {
      "value": "${SHARED_CONTAINER_APPS_ENV_ID}"
    },
    "containerRegistryLoginServer": {
      "value": "${SHARED_ACR_LOGIN_SERVER}"
    },
    "applicationInsightsConnectionString": {
      "value": "${SHARED_APP_INSIGHTS_CONNECTION_STRING}"
    },
    "sqlConnectionString": {
      "value": "${SHARED_SQL_CONNECTION_STRING=}"
    }
  }
}
